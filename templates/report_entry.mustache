{{!
    @template mod_simplejournal/report_entry

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="card mt-4">
    <div class="card-header">
        <strong>{{student}}</strong>
    </div>
    <div class="card-body">
        {{#hasentry}}
            <div class="mod_simplejournal-report-content mb-4">
                {{{content}}}
            </div>
            <div class="text-muted small">
                <div>{{createdlabel}}: {{created}}</div>
                <div>{{modifiedlabel}}: {{modified}}</div>
            </div>
        {{/hasentry}}
        {{^hasentry}}
            <div class="alert alert-info mb-0">{{noentry}}</div>
        {{/hasentry}}
    </div>
</div>
